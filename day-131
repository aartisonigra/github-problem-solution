import java.util.*;

public class Main {
    public static List<Integer> userLogic(List<int[]> points, List<int[]> queries) {
        List<Integer> result = new ArrayList<>();

        for (int[] q : queries) {
            int cx = q[0];
            int cy = q[1];
            int r = q[2];
            int r2 = r * r; // radius squared
            int count = 0;

            for (int[] p : points) {
                int x = p[0];
                int y = p[1];

                int dx = x - cx;
                int dy = y - cy;

                // Compare squared distance
                if (dx * dx + dy * dy <= r2) {
                    count++;
                }
            }
            result.add(count);
        }

        return result;
    }

    public static void main(String[] args) {
        Scanner scanner = new Scanner(System.in);

        int n = scanner.nextInt();
        List<int[]> points = new ArrayList<>();
        for (int i = 0; i < n; i++) {
            int x = scanner.nextInt();
            int y = scanner.nextInt();
            points.add(new int[]{x, y});
        }

        int m = scanner.nextInt();
        List<int[]> queries = new ArrayList<>();
        for (int i = 0; i < m; i++) {
            int x = scanner.nextInt();
            int y = scanner.nextInt();
            int r = scanner.nextInt();
            queries.add(new int[]{x, y, r});
        }

        List<Integer> ans = userLogic(points, queries);

        // Print results
        for (int x : ans) {
            System.out.print(x + " ");
        }
    }
}
